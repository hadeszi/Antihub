                            local priceLabel = goldBtnFrame and goldBtnFrame:FindFirstChild("Frame") and goldBtnFrame.Frame:FindFirstChild("TextLabel")
                            
                            if priceLabel then
                                local priceText = priceLabel.Text:gsub("%$", ""):gsub(",", ""):gsub(" ", "")
                                local priceNum = tonumber(priceText) or 0
                                
                                if priceNum > 0 and currentGold >= priceNum then
                                    upgradeRemote:FireServer("Gold", statName)
                                    task.wait(0.3)
                                end
                            end
                        end
                    end

                    if Config.SelectedUpgrades["Gold"] then CheckAndUpgrade("Gold", "Gold") end
                    if Config.SelectedUpgrades["Luck"] then CheckAndUpgrade("Luck", "Luck") end
                    if Config.SelectedUpgrades["Slots"] then CheckAndUpgrade("Slots", "Slot") end
                    if Config.SelectedUpgrades["Inventory"] then CheckAndUpgrade("Inventory", "Inventory") end
                end
            end)
        end
        task.wait(1.5)
    end
end)
