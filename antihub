local function SanitizeRarityTable(tbl)
    if typeof(tbl) ~= "table" then return tbl end
    local cleanTbl = {}
    for k, v in pairs(tbl) do
        local cleanK = string.gsub(tostring(k), "^%d+%s*-%s*", "")
        cleanTbl[cleanK] = v
    end
    return cleanTbl
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(CONFIG_FILE) then
            local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
            if data then
                for k, v in pairs(data) do
                    if Config[k] ~= nil then
                        Config[k] = v
                    end
                end
                if Config.SelectedBuyRarities then
                    Config.SelectedBuyRarities = SanitizeRarityTable(Config.SelectedBuyRarities)
                end
                if Config.SelectedSellRarities then
                    Config.SelectedSellRarities = SanitizeRarityTable(Config.SelectedSellRarities)
                end
                if data.Language then
                    Lang.Current = data.Language
                end
                if data.CurrentTheme and Themes[data.CurrentTheme] then
                    Theme = Themes[data.CurrentTheme]
                end
            end
        end
    end)
end

