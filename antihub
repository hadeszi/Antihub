-- ==================================================================
local CachedMyPlot = nil

local function DetectPlayerPlot()
    -- Fast return if cache is valid
    if CachedMyPlot and CachedMyPlot.Parent then
        return CachedMyPlot
    end

    local plots = Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("Bases")
    if not plots then return nil end

    local myName = LocalPlayer.Name
    local myNameLower = myName:lower()
    local myDisplayNameLower = LocalPlayer.DisplayName:lower()

    -- 1. Check direct owner attributes / children
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:GetAttribute("Owner") == myName or plot:GetAttribute("Player") == myName or plot:FindFirstChild(myName) then
            CachedMyPlot = plot
            return plot
        end
        local ownerObj = plot:FindFirstChild("Owner") or plot:FindFirstChild("Player")
        if ownerObj then
            if ownerObj:IsA("ObjectValue") and ownerObj.Value == LocalPlayer then
                CachedMyPlot = plot
                return plot
            elseif ownerObj:IsA("StringValue") and (ownerObj.Value:lower() == myNameLower or ownerObj.Value:lower() == myDisplayNameLower) then
                CachedMyPlot = plot
                return plot
            end
        end
    end

    -- 2. Fallback to nearest plot to player
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local closestPlot, closestDist = nil, math.huge
        for _, plot in ipairs(plots:GetChildren()) do
            local pivot = (plot:IsA("Model") and plot:GetPivot().Position) or (plot:FindFirstChildWhichIsA("BasePart") and plot:FindFirstChildWhichIsA("BasePart").Position)
            if pivot then
                local dist = (hrp.Position - pivot).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPlot = plot
                end
            end
        end
        if closestPlot and closestDist < 200 then
            CachedMyPlot = closestPlot
            return closestPlot
        end
    end

    CachedMyPlot = plots:FindFirstChild("Plot6") or plots:GetChildren()[1]
    return CachedMyPlot
end

