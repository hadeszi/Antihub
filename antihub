local function OpenUI()
    CloseAllDropdownsExcept(nil)
    if FloatingWidget then FloatingWidget.Visible = false end
    if MainFrame then
        MainFrame.Visible = true
        MainFrame.BackgroundTransparency = Config.TransparencyLevel
    end
    if Sidebar then
        Sidebar.BackgroundTransparency = Config.TransparencyLevel + 0.1
    end
    if Topbar then
        Topbar.BackgroundTransparency = Config.TransparencyLevel + 0.1
    end
    if MainScale then
        MainScale.Scale = 1
    end
end

local function MinimizeUI()
    CloseAllDropdownsExcept(nil)
    if MainFrame then MainFrame.Visible = false end
    if FloatingWidget then FloatingWidget.Visible = true end
    if MainScale then
        MainScale.Scale = 1
    end
end

local function ToggleUI()
    if MainFrame and MainFrame.Visible then
        MinimizeUI()
    else
        OpenUI()
    end
end

