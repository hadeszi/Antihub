-- 5. SMART AUTO UPGRADE (Checks Gold & Prices)
local t_up = task.spawn(function()
    while true do
        if Config.AutoUpgrade then
            pcall(function()
                local pgui = LocalPlayer:FindFirstChild("PlayerGui")
                local mainUI = pgui and pgui:FindFirstChild("MainUI")
                local upFrame = mainUI and mainUI:FindFirstChild("Frames") and mainUI.Frames:FindFirstChild("Upgrade")
