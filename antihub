local function GetRealPlayerUnits()
    local unitList = {}
    
    -- Method 1: Extract directly from PlayerGui Animes Frame (contains exact in-game UUIDs as card names)
    pcall(function()
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        local mainUI = pgui and pgui:FindFirstChild("MainUI")
        local frames = mainUI and mainUI:FindFirstChild("Frames")
        local animes = frames and frames:FindFirstChild("Animes")
        local selScroll = animes and animes:FindFirstChild("Frame") and animes.Frame:FindFirstChild("Main") and animes.Frame.Main:FindFirstChild("ScrollingFrame")

        if selScroll then
            for _, card in ipairs(selScroll:GetChildren()) do
                if card:IsA("Frame") and card.Name ~= "Template" and card.Name ~= "Configuration" then
                    local realUuid = card.Name
                    local infoFrame = card:FindFirstChild("Frame") and card.Frame:FindFirstChild("Info")
                    local nameLabel = infoFrame and infoFrame:FindFirstChild("AnimeName")
                    local mutLabel = infoFrame and infoFrame:FindFirstChild("Mutation")
                    local lockBtn = card:FindFirstChild("Frame") and card.Frame:FindFirstChild("LockButton")
                    local isLocked = lockBtn and lockBtn:GetAttribute("Locked") == true
                    
                    local rawName = nameLabel and nameLabel.Text or "Unit"
                    local uRarity = DisplayNameToRarityMap[rawName] or UnitNameToRarityMap[rawName] or "Common"
                    local uMut = mutLabel and mutLabel.Text or "None"
                    if uMut == "" or uMut == "nil" then uMut = "None" end
                    
                    local buffLabel = infoFrame and (infoFrame:FindFirstChild("Trait") or infoFrame:FindFirstChild("Buff"))
                    local uBuff = buffLabel and buffLabel.Text or "None"

                    local dName = rawName .. " [" .. uRarity .. "] [Mut: " .. tostring(uMut) .. "] (" .. string.sub(realUuid, 1, 8) .. ")"

                    table.insert(unitList, {
                        Id = realUuid,
                        UUID = realUuid,
                        Name = rawName,
                        Rarity = uRarity,
                        Mutation = uMut,
                        Buff = uBuff,
                        Locked = isLocked,
                        DisplayName = dName
                    })
                end
            end
        end
    end)

    -- Method 2: Fallback to cached module
    if #unitList == 0 and GameInventoryModule and GameInventoryModule.GetInventory then
        pcall(function()
            local inv = GameInventoryModule.GetInventory()
            if typeof(inv) == "table" then
                for id, u in pairs(inv) do
                    local realUuid = u.UUID or u.Uuid or u.uuid or u.Id or u.id or u.Key or tostring(id)
                    local uName = u.Name or "Unit"
                    local uMut = u.Mutation or "None"
                    local uBuff = u.Trait or u.Traits or u.Buff or "None"
                    local uLock = u.Locked or false

                    local uRarity = UnitNameToRarityMap[uName] or DisplayNameToRarityMap[uName] or "Common"
                    local dName = uName .. " [" .. uRarity .. "] [Mut: " .. tostring(uMut) .. "] [Buff: " .. tostring(uBuff) .. "]"
                    
                    table.insert(unitList, {
                        Id = realUuid,
                        UUID = realUuid,
                        Name = uName,
                        Rarity = uRarity,
                        Mutation = uMut,
                        Buff = tostring(uBuff),
                        Locked = uLock,
                        DisplayName = dName
                    })
                end
            end
        end)
    end

    return unitList
end

