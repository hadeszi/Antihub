    ValLabel.Position = UDim2.new(0.7, -14, 0, 8)
    ValLabel.Font = Enum.Font.GothamBold
    ValLabel.Text = tostring(defaultVal) .. " " .. (suffix or "")
    ValLabel.TextColor3 = Theme.Accent
    ValLabel.TextSize = 12
    ValLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValLabel.BackgroundTransparency = 1
    ValLabel.Parent = Card

    table.insert(ThemeElements.Accents, ValLabel)
    table.insert(DynamicElements, {Type = "Header", Element = TitleLabel, Key = titleKey})

    local SliderBar = Instance.new("Frame")
    SliderBar.Size = UDim2.new(1, -28, 0, 7)
    SliderBar.Position = UDim2.new(0, 14, 0, 34)
    SliderBar.BackgroundColor3 = Theme.InputBg
    SliderBar.Parent = Card

    table.insert(ThemeElements.Inputs, SliderBar)

    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(1, 0)
    BarCorner.Parent = SliderBar

    local FillBar = Instance.new("Frame")
    local pct = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
    FillBar.Size = UDim2.new(pct, 0, 1, 0)
    FillBar.BackgroundColor3 = Theme.Accent
    FillBar.BorderSizePixel = 0
    FillBar.Parent = SliderBar

    table.insert(ThemeElements.Sliders, {FillBar = FillBar})

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1, 0)
    FillCorner.Parent = FillBar

    local isDraggingSlider = false
    local function UpdateSlider(input)
        local posX = math.clamp(input.Position.X - SliderBar.AbsolutePosition.X, 0, SliderBar.AbsoluteSize.X)
        local rel = posX / SliderBar.AbsoluteSize.X
        local val = math.floor((minVal + (maxVal - minVal) * rel) * 100) / 100
        FillBar.Size = UDim2.new(rel, 0, 1, 0)
        ValLabel.Text = tostring(val) .. " " .. (suffix or "")
        callback(val)
        SaveConfig()
    end

    SliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingSlider = true
            UpdateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingSlider = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input)
        end
    end)

    return Card
end

