local function CleanAllExistingUIs()
    local targets = {CoreGui, CoreGui:FindFirstChild("RobloxGui"), LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")}
    if gethui then pcall(function() table.insert(targets, gethui()) end) end
    for _, parent in ipairs(targets) do
        if parent then
            for _, child in ipairs(parent:GetChildren()) do
                if child.Name == "AntiHub_RollAnime_UI" then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
end
