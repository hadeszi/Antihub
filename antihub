-- 3. RARITY RULES AUTO BUY (With Gold Price Checking)
local t_buy = task.spawn(function()
    while true do
        if Config.AutoBuy then
            pcall(function()
                local myPlot = DetectPlayerPlot()
                if not myPlot then return end

                local currentGold = GetPlayerGold()
                local plotChars = myPlot:FindFirstChild("Characters")
                
                if plotChars then
                    for _, unit in ipairs(plotChars:GetChildren()) do
                        local unitName = unit.Name
                        local unitMutation = unit:GetAttribute("Mutation") or unit:GetAttribute("Mutations") or "No Mutation"
                        if unitMutation == "" or unitMutation == "None" then
                            unitMutation = "No Mutation"
                        end

                        local unitRarity = UnitNameToRarityMap[unitName] or DisplayNameToRarityMap[unitName] or UnitNameToRarityMap[unitName:lower()]

                        if unitRarity and Config.SelectedBuyRarities[unitRarity] then
                            local charTable = Config.RarityRuleCharacters[unitRarity] or {}
                            local charMatch = (next(charTable) == nil) or (charTable[unitName] == true)

                            local mutTable = Config.RarityRuleMutations[unitRarity] or {}
                            local mutMatch = false
                            if next(mutTable) == nil or mutTable["All (ทุก Mutation)"] then
                                mutMatch = true
                            elseif mutTable["No Mutation (ไม่ติด Mutation)"] and (unitMutation == "No Mutation") then
                                mutMatch = true
                            elseif mutTable[unitMutation] then
                                mutMatch = true
                            end

                            local unitPrice = UnitPriceMap[unitName] or 0
                            local canAfford = (unitPrice == 0) or (currentGold >= unitPrice)

                            if charMatch and mutMatch and canAfford then
                                local hrp = unit:FindFirstChild("HumanoidRootPart") or unit:FindFirstChildWhichIsA("BasePart")
                                local buyPP = hrp and hrp:FindFirstChildOfClass("ProximityPrompt")

                                if buyPP and buyPP.Enabled and fireproximityprompt then
                                    fireproximityprompt(buyPP)
                                end

                                if Remotes and Remotes:FindFirstChild("Characters") and Remotes.Characters:FindFirstChild("Buy") then
                                    Remotes.Characters.Buy:FireServer(unit)
                                end
                            end
                        end
                    end
                end
            end)
        end
